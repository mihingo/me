---
import { ArrowUpRight } from '@lucide/astro';
import { ui } from '../config/ui';
interface Props { email: string; name: string }
const { email, name } = Astro.props;
// Optional: the form only renders when a Formspree endpoint is configured at build time.
const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT as string | undefined;
if (endpoint && !/^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(endpoint)) {
  throw new Error('PUBLIC_FORMSPREE_ENDPOINT must look like https://formspree.io/f/FORM_ID');
}
---
{endpoint && <form class="contact-form" action={endpoint} method="POST" accept-charset="UTF-8" data-contact-form aria-labelledby="contact-form-title" data-email={email} data-sending={ui.form.sending} data-success={ui.form.success} data-error={ui.form.error} data-fallback={ui.form.fallback}>
  <h3 id="contact-form-title" class="meta form-title">{ui.form.title}</h3>
  <div class="form-row">
    <label class="field">
      <span class="field-label">{ui.form.name}</span>
      <input name="name" autocomplete="name" required maxlength="120" />
    </label>
    <label class="field">
      <span class="field-label">{ui.form.email}</span>
      <input name="email" type="email" autocomplete="email" required maxlength="200" spellcheck="false" />
    </label>
  </div>
  <label class="field">
    <span class="field-label">{ui.form.message}</span>
    <textarea name="message" rows="6" required minlength="10" maxlength="5000"></textarea>
  </label>
  <input type="hidden" name="_subject" value={`${ui.form.subject} — ${name}`} />
  <div class="form-trap" aria-hidden="true">
    <label>{ui.form.trap}<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="form-foot">
    <button class="button primary" type="submit" data-submit>
      <span data-submit-label>{ui.form.submit}</span><ArrowUpRight size={17} aria-hidden="true" />
    </button>
    <p class="form-notice">{ui.form.notice}</p>
  </div>
  <p class="form-status" role="status" aria-live="polite" data-status></p>
</form>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const label = form?.querySelector<HTMLElement>('[data-submit-label]');

  function show(state: 'success' | 'error', message: string) {
    if (!form || !status) return;
    form.dataset.state = state;
    status.replaceChildren(message);
    if (state === 'error') {
      const link = document.createElement('a');
      link.href = `mailto:${form.dataset.email}`;
      link.textContent = form.dataset.email!;
      status.append(' ', form.dataset.fallback!, ' ', link, '.');
    }
  }

  form?.addEventListener('submit', async (event) => {
    if (!button || !label || !status) return;
    event.preventDefault();
    const idle = label.textContent;
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    label.textContent = form.dataset.sending!;
    delete form.dataset.state;
    status.replaceChildren();
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (response.ok) {
        form.reset();
        show('success', form.dataset.success!);
      } else {
        const body = await response.json().catch(() => ({})) as { errors?: { message?: string }[] };
        const detail = body.errors?.map((error) => error.message).filter(Boolean).join(' ');
        show('error', detail ? `${form.dataset.error} ${detail}` : form.dataset.error!);
      }
    } catch (error) {
      console.warn('Contact form submission failed.', error);
      show('error', form.dataset.error!);
    } finally {
      button.disabled = false;
      button.removeAttribute('aria-busy');
      label.textContent = idle;
    }
  });
</script>
