---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { localPath } from '../../lib/content';
import type { Project } from '../../lib/schemas';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.filter((entry) => entry.data.visible).map((entry) => ({
    params: { slug: entry.data.slug }, props: { project: entry.data },
  }));
}
interface Props { project: Project }
const { project } = Astro.props;
const destination = `${localPath('/')}#${project.slug}`;
---
<Layout title={`${project.name} — Kelvin Mihingo`} noindex canonicalPath={localPath('/')}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <section class="not-found">
    <h1>{project.name}</h1>
    <a class="text-link" href={destination}>Continue to selected work &rarr;</a>
  </section>
</Layout>
