---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import { localPath } from '../../lib/content';
import type { Project } from '../../lib/schemas';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.filter((entry) => entry.data.visible).map((entry) => ({
    params: { slug: entry.data.slug }, props: { project: entry.data },
  }));
}
interface Props { project: Project }
const { project } = Astro.props;
const home = localPath('/');
---
<Layout title={`${project.name} — Kelvin Mihingo`} description={project.outcome}>
  <section class="case-study">
    <a class="text-link case-back" href={`${home}#work`}><span aria-hidden="true">&larr;</span> Selected work</a>
    <div class="case-hero">
      <p class="eyebrow">{project.category} / {project.period}</p>
      <h1>{project.name}<span aria-hidden="true">.</span></h1>
      <p class="case-lede">{project.summary}</p>
    </div>
    <dl class="case-facts">
      <div><dt>Role</dt><dd>{project.role}</dd></div>
      <div><dt>Impact</dt><dd><strong>{project.metric.value}</strong> {project.metric.label}</dd></div>
      {project.link && <div><dt>Live product</dt><dd><a href={project.link.url} target="_blank" rel="noopener noreferrer">{project.link.label}<Arrow /></a></dd></div>}
    </dl>
    <div class="case-grid">
      <section>
        <p class="eyebrow">The challenge</p>
        <h2>Building for the whole system</h2>
        <p>{project.challenge}</p>
      </section>
      <section>
        <p class="eyebrow">My ownership</p>
        <h2>{project.role}</h2>
        <p>{project.contribution}</p>
      </section>
    </div>
    <section class="case-decisions" aria-labelledby="decisions-title">
      <p class="eyebrow">Engineering decisions</p>
      <h2 id="decisions-title">What moved the work forward</h2>
      <ol>{project.decisions.map((decision, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{decision}</p></li>)}</ol>
    </section>
    <section class="case-result" aria-labelledby="result-title">
      <div>
        <p class="eyebrow">Result</p>
        <h2 id="result-title">{project.outcome}</h2>
      </div>
      <ul class="stack" aria-label={`${project.name} technologies`}>{project.stack.map((item) => <li>{item}</li>)}</ul>
    </section>
    <a class="text-link case-next" href={`${home}#work`}>Explore more selected work <Arrow /></a>
  </section>
</Layout>
