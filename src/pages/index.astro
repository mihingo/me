---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { formatMonth, localPath, orderedProjects, orderedRoles } from '../lib/content';

const [siteEntry, projectEntries, roleEntries] = await Promise.all([
getEntry('site', 'site'), getCollection('projects'), getCollection('experience'),
])                                                                                                                        ;
if (!siteEntry) throw new Error('Missing required src/content/site.yaml');
const site = siteEntry.data                                                                                               ;
const projects = orderedProjects(projectEntries.map((entry) => entry.data))                                               ;
const roles = orderedRoles(roleEntries.map((entry) => entry.data))                                                        ;
---
<Layout>
<section class="intro" aria-labelledby="intro-title">
<p class="eyebrow">{site.role} <span aria-hidden="true">/</span> {site.location}</p>
<h1 id="intro-title">{site.firstName} <span>{site.lastName}<span class="name-dot" aria-hidden="true">.</span></span></h1>
<div class="intro-bottom">
<div class="intro-copy">
<p class="intro-statement">{site.intro}</p>
<p class="current"><span class="current-dot" aria-hidden="true"></span>{site.current}</p>
</div>
<Image src={portrait} alt="Portrait of Kelvin Mihingo" width={144} height={144}
widths={[144, 288]} sizes="144px" format="webp" quality={80} fit="cover" position="top"
loading="eager" class="portrait" />
</div>
</section>

<section id="work" class="section" aria-labelledby="work-title">
<div class="section-heading">
<h2 id="work-title">Selected work</h2>
<span class="eyebrow">01 &mdash; {String(projects.length).padStart(2, '0')}</span>
</div>
<div class="work-list">
{projects.map((project, index) => <article id={project.slug} class="project" aria-labelledby={`${project.slug}-title`}>
<div class="project-index">
<span class="index-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
<span class="eyebrow">{project.category}</span>
</div>
<div class="project-body">
<h3 id={`${project.slug}-title`}>{project.link
? <a href={project.link.url} class="project-title-link" target="_blank" rel="noopener noreferrer">{project.name}<Arrow /></a>
: project.name}</h3>
<p class="project-summary">{project.summary}</p>
<p class="project-outcome">{project.outcome}</p>
<ul class="stack" aria-label={`${project.name} technologies`}>{project.stack.map((item) => <li>{item}</li>)}</ul>
</div>
<div class="project-meta"><span>{project.period}</span><span>{project.role}</span></div>
</article>)}
</div>
<div class="open-source">
<span class="eyebrow">On GitHub</span>
<a href={site.openSource.url} target="_blank" rel="noopener noreferrer">{site.openSource.label}<Arrow /></a>
<p>{site.openSource.description}</p>
</div>
</section>

<section id="experience" class="section" aria-labelledby="experience-title">
<div class="section-heading">
<h2 id="experience-title">Along the way</h2>
<a class="text-link" href={localPath(site.resume.path)} target="_blank" rel="noopener noreferrer">Full resume<Arrow /></a>
</div>
<ol class="experience-list">
{roles.map((role) => <li class="experience-row">
<p class="role-dates"><time datetime={role.start}>{formatMonth(role.start)}</time><span aria-hidden="true"> &mdash; </span><span class="sr-only"> to </span>{role.end === 'present' ? <span class="present">Now</span> : <time datetime={role.end}>{formatMonth(role.end)}</time>}</p>
<h3>{role.company}</h3>
<div class="role-detail"><p>{role.title}</p><p>{role.focus}</p></div>
</li>)}
</ol>
<div class="education">
<span class="eyebrow">Education</span>
<p>{site.education.degree}<span>{site.education.institution}</span></p>
<span class="education-years">{site.education.years}</span>
</div>
</section>

<section id="contact" class="contact" aria-labelledby="contact-title">
<p class="eyebrow">Have something in mind?</p>
<h2 id="contact-title"><a href={`mailto:${site.email}`}>Let's talk.<Arrow /></a></h2>
<div class="contact-bottom">
<a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
<ul class="social-links">{site.social.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Arrow /></a></li>)}</ul>
</div>
</section>
</Layout>
