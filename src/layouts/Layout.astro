---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import '@fontsource/instrument-serif/latin.css';
import '@fontsource/instrument-serif/latin-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import displayItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import Header from '../components/Header.astro';
import { localPath, plainText } from '../lib/content';
import { ui } from '../config/ui';
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean }
const entry = await getEntry('site', 'site');
if (!entry) throw new Error('Missing required src/content/site.yaml');
const site = entry.data;
const { title = site.seo.title, description = site.seo.description, noindex = false } = Astro.props;
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin).href;
const og = new URL(localPath('/og.png'), origin).href;
const tokens = (values: Record<string, string>, prefix = '') => Object.entries(values).map(([key, value]) => `--${prefix}${key}:${value}`).join(';');
const { dark, light } = site.theme;
// Dark "plates" always use the dark palette; in dark mode they sit one step lighter than the page.
const darkBand = tokens(dark, 'band-');
const darkModeBand = tokens({ ...dark, background: dark.surface, surface: dark.background }, 'band-');
// The portrait's white studio backdrop is dimmed slightly in dark mode so it doesn't glare.
const lightPortrait = '--portrait-filter:none';
const darkPortrait = '--portrait-filter:brightness(.88)';
const themeCSS = `:root{${tokens(dark)};${darkModeBand};${darkPortrait};--heading:"${site.theme.fonts.heading}";--body:"${site.theme.fonts.body}";--mono:"${site.theme.fonts.mono}";--radius:${site.theme.radius};color-scheme:dark}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]){${tokens(light)};${darkBand};${lightPortrait};color-scheme:light}}
:root[data-theme="light"]{${tokens(light)};${darkBand};${lightPortrait};color-scheme:light}
:root[data-theme="dark"]{${tokens(dark)};${darkModeBand};${darkPortrait};color-scheme:dark}`;
const portrait = site.portrait ? await getImage({ src: site.portrait.src, width: 408, format: 'webp' }) : undefined;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  url: new URL(localPath('/'), origin).href, email: `mailto:${site.email}`,
  jobTitle: site.role, description: plainText(site.headline), sameAs: site.social.map((link) => link.url),
  homeLocation: { '@type': 'Place', name: site.location },
  ...(portrait && { image: new URL(portrait.src, origin).href }),
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const builtAt = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date());
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={localPath('/favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={displayItalic} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={site.seo.ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={site.seo.ogAlt} />
    <style is:inline set:html={themeCSS}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const preference = localStorage.getItem('portfolio-theme');
        if (preference && ['system', 'dark', 'light'].includes(preference)) document.documentElement.dataset.theme = preference;
        else if (preference) console.warn('Invalid saved theme preference; using system theme.');
      } catch (error) { console.warn('Theme storage unavailable; using system theme.', error); }
    </script>
    <script type="application/ld+json" is:inline set:html={json(structuredData)}></script>
    {site.analytics.enabled && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analytics.token })}></script>}
  </head>
  <body>
    <a href="#main" class="skip-link">{ui.skip}</a>
    <Header site={site} />
    <main id="main" tabindex="-1"><slot /></main>
    <aside class="quick-contact" aria-label={ui.quickContact}>
      <a class="mobile-contact" href={`mailto:${site.email}`}>{ui.contact}<ArrowUpRight size={17} aria-hidden="true" /></a>
    </aside>
    <script>
      // The floating shortcut is redundant (and would cover content) while the contact section is on screen.
      const shortcut = document.querySelector('.mobile-contact');
      const contact = document.getElementById('contact');
      if (shortcut && contact && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => shortcut.classList.toggle('is-away', entry!.isIntersecting)).observe(contact);
      }
    </script>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span class="wordmark-mark" aria-hidden="true"></span>
        <span>{site.name}</span>
        <span class="muted">{site.location}</span>
        <span class="meta footer-updated">{ui.updated} {builtAt}</span>
      </div>
    </footer>
  </body>
</html>
