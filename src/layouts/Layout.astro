---
import { getEntry } from 'astro:content';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Arrow from '../components/Arrow.astro';
import { localPath } from '../lib/content';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean; canonicalPath?: string }
const entry = await getEntry('site', 'site');
if (!entry) throw new Error('Missing required src/content/site.yaml');
const site = entry.data;
const { title = site.seo.title, description = site.seo.description, noindex = false, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).href;
const og = new URL(localPath('/og.png'), Astro.site).href;
const home = localPath('/');
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  url: new URL(home, Astro.site).href, jobTitle: site.role,
  description: site.intro, sameAs: site.social.map((link) => link.url),
  homeLocation: { '@type': 'Place', name: site.location },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={localPath('/favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={site.seo.ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={site.seo.ogAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href={home} aria-label={`${site.name} — Home`}>km<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${home}#work`}>Work</a>
        <a href={`${home}#experience`}>Experience</a>
        <a href={`${home}#contact`}>Contact</a>
      </nav>
      <a class="resume-link" href={localPath(site.resume.path)} target="_blank" rel="noopener noreferrer">{site.resume.label}<Arrow /></a>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <span>&copy; {new Date().getFullYear()} {site.firstName} {site.lastName}</span>
      <span>{site.location}</span>
      <a href="#main">Back to top <span aria-hidden="true">&uarr;</span></a>
    </footer>
  </body>
</html>
