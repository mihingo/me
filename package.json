{
  "name": "kelvin-mihingo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "pnpm content:check && pnpm assets && astro dev --host 127.0.0.1",
    "assets": "tsx scripts/assets.ts",
    "build": "pnpm content:check && pnpm assets && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "content:check": "tsx scripts/validate-content.ts",
    "test:unit": "tsx --test tests/content.test.ts",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "budget": "tsx scripts/budget.ts",
    "test:config": "tsx scripts/prove-content.ts",
    "lighthouse": "lhci autorun",
    "new": "node scripts/new.mjs",
    "capture:psms": "tsx scripts/capture-psms.ts",
    "test:form": "tsx scripts/prove-form.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lucide/astro": "1.52.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/inter": "^5.2.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pdf-lib": "^1.17.1",
    "satori": "0.35.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ]
  }
}
