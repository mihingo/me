# Set this to the final origin before publishing; never include a path.
SITE_URL=https://mihingo.github.io
# For a project repository: /REPOSITORY-NAME. For a custom domain: /
BASE_PATH=/me/
# Public Web3Forms access key. It is exposed in the rendered form by design.
PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
